Algoritmo TiposDeInstrucciones
	// Intrucciones de DEclaracion
	Definir x, s, resultado Como Entero
	
	// Intruccion de Entrada
	Leer x
	
	//Intruccion de Asignacion
	s <- 10
	resultado <- x + s
	
	// Intruccion selectiva
	si resultado > 15 Entonces
		// Instruccion de salida
		Escribir "El numero supera el limite."
		
	FinSi
FinAlgoritmo
